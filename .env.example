# ============================================================
# SDLC Manager  -  Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in the values.
# All model names, credentials, and thresholds are configurable here.
# Zero hardcoding  -  the application reads everything from this file.

# ---- Google Cloud / Vertex AI (REQUIRED) ----
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: Use Gemini API Key instead of Vertex AI
# GEMINI_API_KEY=

# ---- Agent Identity ----
AGENT_NAME=sdlc_manager

# ---- Model Configuration (ALL configurable via env) ----
ORCHESTRATOR_MODEL=gemini-3.7-flash
GIT_AGENT_MODEL=gemini-3.7-flash
VALIDATION_AGENT_MODEL=gemini-3.7-flash
REVIEW_AGENT_MODEL=gemini-3.1-pro-preview
TERRAFORM_AGENT_MODEL=gemini-3.7-flash
AI_REVIEW_MODEL=gemini-3.7-flash
AI_FALLBACK_MODEL=gemini-3.7-flash

# ---- AI Review Settings ----
AI_MAX_OUTPUT_TOKENS=32768
AI_FULL_REWRITE_MAX_LINES=1200
AI_MAX_RETRIES=3

# ---- GitHub (REQUIRED for PR operations) ----
# Create at: https://github.com/settings/tokens  -  needs 'repo' scope
# GITHUB_TOKEN=ghp_your_personal_access_token

# ---- Server ----
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
SERVE_WEB_INTERFACE=FALSE
RELOAD_AGENTS=FALSE

# ---- Authentication ----
AUTH_ENABLED=FALSE
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_EXPIRY_HOURS=8
ALLOWED_EMAIL_DOMAINS=*

# ---- Session / Memory / Artifacts ----
# SESSION_SERVICE_URI=
# MEMORY_SERVICE_URI=
# ARTIFACT_SERVICE_URI=

# ---- CORS ----
ALLOW_ORIGINS=["http://127.0.0.1:8000", "http://localhost:8000"]

# ---- Validation & FinOps ----
FINOPS_MAX_BYTES_THRESHOLD=10737418240
# SQL_DATASET_MAP=AEDW_DB=DB_AEDWD2,STG_DB=DB_STG2
SQL_PARAM_COLUMNS=etl_batch_sk
SCHEMA_CACHE_TTL=900

# ---- Terraform ----
TERRAFORM_COMMAND_TIMEOUT=120

# ---- Git ----
GIT_DEFAULT_BRANCH=main
GIT_COMMAND_TIMEOUT=30

# ---- Rate Limiting ----
RATE_LIMIT_API=60/minute
RATE_LIMIT_AI_REVIEW=10/minute

# ---- OpenTelemetry ----
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=TRUE